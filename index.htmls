<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Virus Simulation</title>

  <style>
    body {
      margin: 0;
      background: #050505;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
    }

    #box {
      margin: 60px 20px;
      padding: 25px;
      border: 2px solid red;
      border-radius: 15px;
    }

    #status {
      color: #ff3333;
      font-size: 22px;
      font-weight: bold;
    }

    #log {
      margin-top: 20px;
      background: #111;
      padding: 15px;
      text-align: left;
      border-radius: 10px;
      white-space: pre-wrap;
      font-family: monospace;
    }

    button {
      margin-top: 20px;
      padding: 12px 25px;
      border: 0;
      border-radius: 10px;
      background: red;
      color: white;
      font-size: 16px;
    }
  </style>
</head>

<body>

<div id="box">

  <h1>🦠 Malware Simulation</h1>

  <div id="status">
    Simulation starting...
  </div>

  <div id="log"></div>

  <button onclick="stopSimulation()">
    STOP
  </button>

</div>

<script>

let stopped = false;

const logBox = document.getElementById("log");
const status = document.getElementById("status");

function log(text) {
  logBox.textContent += text + "\n";
}

function wait(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

async function simulation() {

  log("[1] Starting simulation...");
  await wait(1000);

  if (stopped) return;

  log("[2] Checking environment...");
  await wait(1000);

  if (stopped) return;

  log("[3] Simulating suspicious activity...");
  await wait(1000);

  if (stopped) return;

  log("[4] Simulating fake file scan...");
  await wait(1000);

  if (stopped) return;

  // ملفات وهمية فقط داخل الذاكرة
  const fakeFiles = [
    "game/data/player.dat",
    "game/cache/temp.dat",
    "game/config/settings.dat"
  ];

  for (const file of fakeFiles) {

    if (stopped) return;

    log("Scanning: " + file);

    await wait(500);
  }

  if (stopped) return;

  log("[5] Simulation complete.");

  status.textContent = "⚠️ SIMULATION ONLY";

  log("");
  log("Nothing was damaged.");
  log("No files were deleted.");
  log("No passwords were collected.");
  log("No data was sent.");
  log("No propagation occurred.");

}

function stopSimulation() {

  stopped = true;

  status.textContent = "🛑 Simulation stopped";

  log("");
  log("[STOP] Simulation terminated.");

}

simulation();

</script>

</body>
</html>
